ENV=development
# version
VERSION=1.0.0
# server
PUBLIC_SERVER_PORT=9001
# logs
LOG_LEVEL=debug
# ratelimit
RATELIMIT_WINDOW=1800000
RATELIMIT_MAX_REQUEST_PER_WINDOW=100
# services — replace with your own service URLs
BACKEND_PUBLIC_HOST=http://localhost:9000
BACKEND_PRIVATE_HOST=http://localhost:9981
AI_SERVICE=http://localhost:7100
IPS_SERVICE=http://localhost:6006
MARKETPLACE_SERVICE=http://localhost:9982
ACTIVEPIECES_BACKEND_HOST=http://localhost:3000
ACTIVEPIECES_ENGINE_HOST=http://localhost:3001
# Comma-separated list of trusted sources for ActivePieces webhooks/socket.io (hosts or IPs)
ACTIVEPIECES_TRUSTED_SOURCES=localhost,127.0.0.1
AUTH_SERVICE_URL=http://localhost:3000
