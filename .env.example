ENV=development
VERSION=1.0.0

# Server ports
PUBLIC_SERVER_PORT=9001

# Logging
LOG_LEVEL=debug

# Rate limiting
RATELIMIT_WINDOW=1800000
RATELIMIT_MAX_REQUEST_PER_WINDOW=100

# Backend service
BACKEND_PUBLIC_HOST=http://localhost:9000
BACKEND_PRIVATE_HOST=http://localhost:9981

# AI services
AI_SERVICE=http://localhost:7100
AI_SERVICE_PYTHON=http://localhost:7101
AI_CHAT_WEBSOCKET=http://localhost:7100

# IPS / Scheduler service
IPS_SERVICE=http://localhost:6006

# Marketplace service
MARKETPLACE_SERVICE=http://localhost:9982

# Platform service
PLATFORM_SERVICE_HOST=http://localhost:6040

# File service
FILE_SERVICE_HOST=http://localhost:8866

# Data Board service
DATA_BOARD_HOST=http://localhost:8081
DATA_BOARD_PROXY_TOKEN=

# Message Suggestion service
MESSAGE_SUGGESTION_HOST=http://localhost:8082

# Channel service
CHANNEL_SERVICE_HOST=http://localhost:4100
CHANNEL_SERVICE_ENABLED=true

# Auth service (JWT validation)
AUTH_SERVICE_URL=http://localhost:3000

# Workflow engine host
WORKFLOW_HOST=http://localhost:5678

# Workflow engine
ACTIVEPIECES_BACKEND_HOST=http://localhost:3000
ACTIVEPIECES_ENGINE_HOST=http://localhost:3001
ACTIVEPIECES_WS_HOST=http://localhost:3000
# Comma-separated list of trusted IPs/hosts for Workflow webhooks & socket.io
ACTIVEPIECES_TRUSTED_SOURCES=localhost,127.0.0.1
